# =====================================================================
# KHAIRA COMPANY - MULTILINGUAL AI VOICE AUTOMATION PLATFORM
# Environment Configuration Template
# =====================================================================

PROJECT_NAME="Khaira AI Voice Automation Platform"
COMPANY_NAME="Khaira Company"
VERSION="2.0.0"
ENV="development"
DEBUG=True

# Security & Authentication
SECRET_KEY="khaira-enterprise-voice-secret-key-prod-2026-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM="HS256"

# Database Configuration
# Local async zero-dependency SQLite fallback:
DATABASE_URL="sqlite+aiosqlite:///./nexora.db"
# Production PostgreSQL (uncomment for production):
# DATABASE_URL="postgresql+asyncpg://khaira_user:YourSecurePassword@localhost:5432/khaira_voice_db"

# AI Voice & Local LLM (Ollama or Cloud Fallback)
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_LLM_MODEL="llama3.2:latest"
FALLBACK_LLM_PROVIDER="mock_local"
CONFIDENCE_THRESHOLD=0.65

# High-Volume Concurrency & Scalable Call Queue Architecture
MAX_CONCURRENT_CALLS=1000
CALL_WORKER_POOL_SIZE=32
CALL_QUEUE_CAPACITY=5000
RATE_LIMIT_PER_MINUTE=120
CALL_SESSION_TTL_SECONDS=1800

# File Storage
STORAGE_DIR="./data_storage"
UPLOAD_MAX_SIZE_MB=25

# Telephony Gateway Configuration (Asterisk ARI / FreeSWITCH ESL / SIP Trunk / WebRTC)
SIP_HOST="127.0.0.1"
SIP_PORT=5060
SIP_USER="khaira_voice_agent"
SIP_PASSWORD="khaira_sip_secret"
TELEPHONY_MODE="browser_simulated"

# Voice & Speech Synthesis Settings
DEFAULT_LANGUAGE="en"
TTS_PROVIDER="edge_tts"
STT_PROVIDER="faster_whisper"

# Regulatory Compliance (India DPDPA 2023 & TRAI DND)
DPDPA_COMPLIANCE_ENABLED=True
CALL_RECORDING_CONSENT_REQUIRED=True
DND_SCRUBBING_ENABLED=True
