PROJECT_NAME="NEXORA AI"
VERSION="1.0.0"
ENV="development"
DEBUG=True
SECRET_KEY="nexora-secret-super-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database: SQLite async for out-of-the-box local operation or PostgreSQL for production
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/nexora_ai
DATABASE_URL="sqlite+aiosqlite:///./nexora.db"

# AI Voice & Local LLM (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_LLM_MODEL="llama3.2:latest"
FALLBACK_LLM_PROVIDER="mock_local"
CONFIDENCE_THRESHOLD=0.65

# Storage
STORAGE_DIR="./data_storage"
UPLOAD_MAX_SIZE_MB=25

# Telephony Gateway
SIP_HOST="127.0.0.1"
SIP_PORT=5060
SIP_USER="nexora_agent"
SIP_PASSWORD="nexora_sip_secret"
TELEPHONY_MODE="browser_simulated"

# Voice Settings
DEFAULT_LANGUAGE="en"

